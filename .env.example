# TraceLens environment configuration (example)
# Copy to .env and adjust as needed. The backend currently derives all paths
# from the repository root and does not require any secret to run locally.

# Backend server
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:5173

# Generator defaults
GENERATOR_SEED=20261120
N_NORMAL=1200
N_ANOMALY=240

# Detector defaults
DEFAULT_METHOD=isolation_forest
IF_THRESHOLD=0.5
IF_CONTAMINATION=0.1
MAD_Z_THRESHOLD=3.5
MAD_THRESHOLD=0.3

# Optional external services (not used by the core app)
# SENDGRID_API_KEY=
# SUPABASE_URL=
# SUPABASE_KEY=
